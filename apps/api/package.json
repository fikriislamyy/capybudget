{
  "name": "@capybudget/api",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "dev": "bun --env-file=../../.env --hot src/dev.ts",
    "worker": "bun --env-file=../../.env --hot src/email/worker.ts",
    "email:preview": "bun scripts/preview-emails.ts",
    "worker:tracking": "bun --env-file=../../.env --hot src/tracking/worker.ts",
    "worker:assistant": "bun --env-file=../../.env --hot src/assistant/worker.ts",
    "test": "bun test tests/auth",
    "test:integration": "AUTH_INTEGRATION=1 bun --env-file=../../.env test tests/auth/local-flow.test.ts",
    "test:tracking": "bun --env-file=../../.env test tests/tracking",
    "test:tracking:integration": "TRACKING_INTEGRATION=1 bun --env-file=../../.env test tests/tracking",
    "test:personal-finance": "bun test tests/personal-finance ../api/tests/tracking/recurrence.test.ts",
    "test:notifications": "bun test tests/notifications",
    "test:assistant": "bun test tests/assistant tests/tracking/recurrence.test.ts tests/personal-finance/money.test.ts",
    "test:assistant:integration": "TRACKING_INTEGRATION=1 bun --env-file=../../.env test tests/tracking/workspace.test.ts",
    "benchmark:assistant": "bun scripts/assistant-benchmark.ts",
    "assistant:query-plans": "bun scripts/assistant-query-plans.ts",
    "assistant:redis-persistence": "bun scripts/assistant-redis-persistence.ts",
    "backtest:assistant": "bun scripts/assistant-backtest.ts",
    "check": "tsc --noEmit",
    "db:generate": "bun --env-file=../../.env run drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env run drizzle-kit migrate",
    "db:studio": "bun --env-file=../../.env run drizzle-kit studio",
    "db:cleanup-auth": "bun --env-file=../../.env src/db/cleanup-expired-auth.ts",
    "db:fresh": "bun --env-file=../../.env scripts/db-fresh.ts",
    "test:business:setup": "bun --env-file=../../.env scripts/business-test-db.ts",
    "test:business": "bun --env-file=../../.env scripts/business-checks.ts",
    "test:business:browser": "bun --env-file=../../.env scripts/business-browser-checks.ts",
    "test:business:mailpit": "BUSINESS_MAILPIT=1 bun --env-file=../../.env scripts/business-checks.ts",
    "deploy:preflight": "bun --env-file=../../.env scripts/deployment-preflight.ts",
    "test:assistant:v2:setup": "bun --env-file=../../.env scripts/assistant-v2-test-db.ts",
    "test:assistant:v2": "bun --env-file=../../.env scripts/assistant-v2-checks.ts",
    "test:assistant:v2:browser": "bun --env-file=../../.env scripts/assistant-v2-browser-checks.ts",
    "evaluate:assistant:detection": "bun scripts/assistant-detection-evaluation.ts",
    "test:assistant:v2:live": "bun --env-file=../../.env scripts/assistant-v2-live-checks.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "latest",
    "@aws-sdk/lib-storage": "latest",
    "@elysiajs/cors": "latest",
    "@elysiajs/openapi": "latest",
    "@napi-rs/canvas": "^1.0.10",
    "@simplewebauthn/server": "^14.0.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "archiver": "^8.0.0",
    "better-auth": "latest",
    "bullmq": "latest",
    "csv-parse": "^7.0.3",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "latest",
    "elysia": "latest",
    "exceljs": "^4.4.0",
    "ioredis": "latest",
    "nodemailer": "latest",
    "pdfjs-dist": "^6.4.299",
    "playwright": "1.63.0",
    "postgres": "latest",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bun": "latest",
    "@types/nodemailer": "latest",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "latest",
    "typescript": "~6.0.0"
  }
}
