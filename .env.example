DATABASE_URL=postgres://capybudget:capybudget@localhost:5432/capybudget
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5173
BETTER_AUTH_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
API_INTERNAL_URL=http://localhost:3000
# Only set these when the immediate peer is a trusted reverse proxy. Leave empty locally.
TRUSTED_PROXY_IPS=
TRUSTED_PROXY_HOPS=1
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=capybudget
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# Local Mailpit has no SMTP authentication. Configure SMTP_USER/SMTP_PASSWORD in production.
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=CapyBudget <no-reply@capybudget.local>
# Generate with: openssl rand -base64 32
EMAIL_JOB_ENCRYPTION_KEY=replace-with-a-random-32-byte-base64-key
