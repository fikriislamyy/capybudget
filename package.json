{
  "name": "capybudget",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun --env-file=.env --hot apps/api/src/dev.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:api": "bun --env-file=.env --hot apps/api/src/server.ts",
    "dev:worker": "bun --hot apps/api/src/email/worker.ts",
    "dev:tracking-worker": "bun --hot apps/api/src/tracking/worker.ts",
    "dev:assistant-worker": "bun --env-file=.env --hot apps/api/src/assistant/worker.ts",
    "build": "bun run --cwd apps/web build",
    "check": "bun run --cwd apps/web check && bun run --cwd apps/api check",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "db:studio": "bun run --cwd apps/api db:studio",
    "db:cleanup-auth": "bun run --cwd apps/api db:cleanup-auth",
    "test:auth": "bun test apps/api/tests/auth",
    "test:personal-finance": "bun test apps/api/tests/personal-finance apps/api/tests/tracking/recurrence.test.ts",
    "test:assistant": "bun run --cwd apps/api test:assistant",
    "test:assistant:integration": "bun run --cwd apps/api test:assistant:integration",
    "benchmark:assistant": "bun run --cwd apps/api benchmark:assistant",
    "backtest:assistant": "bun run --cwd apps/api backtest:assistant",
    "test:auth:integration": "bun run --cwd apps/api test:integration",
    "test:tracking": "bun run --cwd apps/api test:tracking",
    "test:tracking:integration": "bun run --cwd apps/api test:tracking:integration",
    "test:auth:e2e": "bun run --cwd apps/web test:e2e"
  },
  "engines": { "bun": ">=1.2.0" }
}
